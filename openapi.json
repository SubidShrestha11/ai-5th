  "components": {
    "schemas": {
      "ActionEnum": {
        "enum": ["accept", "decline"],
        "type": "string",
        "description": "* `accept` - Accept\n* `decline` - Decline"
      },
      "FeedActivity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FriendUser"
              }
            ],
            "readOnly": true
          },
          "movie": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Movie"
              }
            ],
            "readOnly": true
          },
          "watched_date": {
            "type": "string",
            "format": "date",
            "readOnly": true
          },
          "rating": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,2}(?:\\.\\d{0,1})?$",
            "readOnly": true,
            "nullable": true
          },
          "review_text": {
            "type": "string",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "id",
          "movie",
          "rating",
          "review_text",
          "updated_at",
          "user",
          "watched_date"
        ]
      },
      "FriendRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "sender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FriendUser"
              }
            ],
            "readOnly": true
          },
          "receiver": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FriendUser"
              }
            ],
            "readOnly": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FriendStatusEnum"
              }
            ],
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "id",
          "receiver",
          "sender",
          "status",
          "updated_at"
        ]
      },
      "FriendRequestCreateRequest": {
        "type": "object",
        "properties": {
          "receiver_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["receiver_id"]
      },
      "FriendStatusEnum": {
        "enum": ["pending", "accepted", "declined"],
        "type": "string",
        "description": "* `pending` - Pending\n* `accepted` - Accepted\n* `declined` - Declined"
      },
      "FriendUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "bio": {
            "type": "string",
            "readOnly": true
          },
